{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoDock",
  "version": "0.5.1",
  "identifier": "dev.autodock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoDock",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Configure projetos locais com Docker de forma guiada",
    "longDescription": "AutoDock analisa projetos locais e gera Dockerfile e docker-compose.yml com um assistente guiado, sem instalar nada além do Docker.",
    "copyright": "Copyright 2026 AutoDock contributors. Apache-2.0",
    "publisher": "AutoDock",
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "AutoDock",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RUQ4Nzc3ODQzOTA0OTUKUldTVkJEbUVkNGZ0dDRJdXFLYnpya2RIN0FrTnAyWGJZeEtVVytvd011OE5mMkFmRDZLRE9mWU0K",
      "endpoints": [
        "https://github.com/joaopanucci/autodock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
